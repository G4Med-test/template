Bootstrap: oras
From: ghcr.io/g4med-test/geant4-alma9:{{ TAG }}

# The base image provides Geant4 (/opt/geant4), compilers, CMake and Python with
# NumPy/uproot (/opt/venv), and already sets PATH, LD_LIBRARY_PATH and the
# dataset variables (/g4data): no %environment section is needed here.
%arguments
    TAG=v11.3.2
    PROJECT_NAME=G4TestGeneric

%labels
    Project {{ PROJECT_NAME }}
    Description "Apptainer container for {{ PROJECT_NAME }}"

%files
    . /source

%post
    set -eu
    cmake -S /source -B /tmp/build -DCMAKE_PREFIX_PATH=/opt/geant4 -DPROJECT_NAME_OVERRIDE="{{ PROJECT_NAME }}"
    cmake --build /tmp/build --parallel "$(nproc)"
    cmake --install /tmp/build
    rm -rf /tmp/build

%runscript
    exec /usr/local/bin/{{ PROJECT_NAME }} "$@"
